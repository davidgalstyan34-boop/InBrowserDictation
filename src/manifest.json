{
  "manifest_version": 3,
  "name": "In-Browser Dictation",
  "version": "0.1.0",
  "description": "Shortcut-driven dictation with later STT, LLM rewriting, and safe insertion.",
  "permissions": [
    "storage",
    "offscreen",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.deepgram.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Start or stop dictation"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/content-app.js",
        "content/overlay.js",
        "content/target-capture.js",
        "content/text-insertion.js",
        "shared/messages.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "options/options.html"
}
